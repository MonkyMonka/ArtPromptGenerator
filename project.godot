; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ArtPromptGen"
config/version="1.0"
run/main_scene="res://scene/control.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="ArtPromptGen"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/low_processor_mode=true
config/icon="res://assets/New Project.png"
run/stretch/scale_mode="fractional"
run/stretch/scale=1.0

[display]

window/size/viewport_width=875
window/size/viewport_height=750
window/size/resizable=false
window/energy_saving/keep_screen_on=false
window/stretch/aspect="ignore"
mouse_cursor/custom_image="uid://2in84cty3ems"

[physics]

2d/physics_engine="Dummy"
3d/physics_engine="Dummy"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
